# Variables d'environnement Vite — Kinetic Web
# Copier en .env.local et compléter avec vos vraies valeurs.

# ─── Supabase (obligatoire pour l'auth et la sync cloud) ────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# URL de production (utilisée par l'auth callback)
VITE_PUBLIC_SITE_URL=https://kinetic.example.com

# Versionnage affiché dans le profil
VITE_APP_VERSION=1.0.0

# ─── Web Push (optionnel — désactive le bloc UI si vide) ────────────────
# Génération : npx web-push generate-vapid-keys
# La clé privée correspondante doit être stockée comme secret Supabase :
#   supabase secrets set VAPID_PRIVATE_KEY=...
VITE_VAPID_PUBLIC_KEY=
