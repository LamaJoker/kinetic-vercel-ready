{
  "name": "@kinetic/web",
  "version": "8.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ../../scripts/sync-web-dist.mjs",
    "preview": "vite preview",
    "preview:ci": "vite preview --port 3000",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:build": "vite build && cap sync android && cd android && gradlew.bat assembleDebug",
    "android:build:release": "vite build && cap sync android && cd android && gradlew.bat assembleRelease",
    "android:run": "cap run android"
  },
  "dependencies": {
    "@alpinejs/csp": "^3.15.12",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.8",
    "@kinetic/adapters-web": "workspace:*",
    "@kinetic/core": "workspace:*",
    "@supabase/supabase-js": "^2.106.2",
    "alpinejs": "^3.15.12",
    "idb-keyval": "^6.2.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@types/alpinejs": "^3.13.10",
    "@types/node": "^20.19.42",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0",
    "vite": "^6.0.0"
  }
}
