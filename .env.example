# ══════════════════════════════════════════════════════════════
# Kinetic — Variables d'environnement
#
# USAGE :
#   1. Copier ce fichier : cp .env.example apps/web/.env.local
#   2. Remplir les valeurs Supabase
#   3. Ne JAMAIS committer .env.local
#
# Vercel : Dashboard → Settings → Environment Variables
# ══════════════════════════════════════════════════════════════

# ─── Supabase ─────────────────────────────────────────────────
# Obtenir dans : Supabase Dashboard → Settings → API

# URL de votre projet Supabase
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clé publique anonyme (safe à exposer côté client)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── App ──────────────────────────────────────────────────────

# Version de l'app (injectée par CI via git SHA)
VITE_APP_VERSION=1.0.0

# URL publique canonique de l'app — REQUIS pour APK Android.
# Utilisée comme redirect URL OAuth/magic-link. Sans ça, callbackUrl()
# tombe sur window.location.origin = "https://localhost" sur APK,
# Supabase rejette ce redirect (ou fallback sur Site URL) et l'APK
# ne reçoit jamais le deep link → l'utilisateur reste connecté côté web.
VITE_PUBLIC_SITE_URL=https://kinetic-prod.vercel.app

# Démo portfolio : autorise l'activation Pro locale sans paiement (mode invité).
# Laisser vide en production réelle.
VITE_DEMO_UNLOCK_PRO=

# ─── Clés serveur ─────────────────────────────────────────────
# AUCUNE clé serveur ici ni dans Vercel (l'app déployée est statique).
# SUPABASE_SERVICE_ROLE_KEY est injectée automatiquement dans les Edge
# Functions Supabase ; ANTHROPIC_API_KEY se configure avec :
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...

# ─── OAuth (optionnel) ────────────────────────────────────────
# Configurer dans : Supabase → Auth → Providers → Google
# Les credentials OAuth restent dans Supabase, pas dans .env

# ─── Mode dev ─────────────────────────────────────────────────
# En mode dev sans Supabase : laisser les variables vides
# L'app fonctionne en mode "guest" avec IDB local uniquement
